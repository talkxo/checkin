# INSYDE — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit real
# secrets — this file only documents what each variable is for.

# ────────────────────────────────────────────────────────────────
# Supabase
# ────────────────────────────────────────────────────────────────

# Supabase project URL (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key (public — safe to expose to the browser,
# access is restricted by Row Level Security policies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (SECRET — server-side only, bypasses RLS).
# Never expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# ────────────────────────────────────────────────────────────────
# Auth
# ────────────────────────────────────────────────────────────────

# Secret used to HMAC-sign admin/user session cookies. Required in
# production — the app throws at startup if it's unset in production.
# Generate a strong random value, e.g.: openssl rand -hex 32
AUTH_SECRET=

# ────────────────────────────────────────────────────────────────
# Admin credentials
# ────────────────────────────────────────────────────────────────

# Username for the /admin dashboard login
ADMIN_USERNAME=

# Password for the /admin dashboard login (SECRET)
ADMIN_PASSWORD=

# ────────────────────────────────────────────────────────────────
# AI / OpenRouter
# ────────────────────────────────────────────────────────────────

# OpenRouter API key used by the AI assistant / smart notification
# features (lib/ai.ts, /api/ai/* routes). Keep set even while the
# user-facing AI is feature-flagged off.
OPENROUTER_API_KEY=

# ────────────────────────────────────────────────────────────────
# Push notifications (Web Push / VAPID)
# ────────────────────────────────────────────────────────────────

# VAPID public key, exposed to the browser to subscribe to push.
# Generate both VAPID keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# VAPID private key (SECRET — server-side only, used to sign push payloads)
VAPID_PRIVATE_KEY=

# Contact email associated with the VAPID keys, e.g. mailto:admin@talkxo.com
VAPID_EMAIL=

# ────────────────────────────────────────────────────────────────
# Basecamp integration
# ────────────────────────────────────────────────────────────────

# Basecamp OAuth app client ID
BC_CLIENT_ID=

# Basecamp OAuth app client secret (SECRET)
BC_CLIENT_SECRET=

# Basecamp account ID the app posts to
BC_ACCOUNT_ID=

# Basecamp project (bucket) ID the app posts to
BC_PROJECT_ID=

# Basecamp campfire/chat ID the app posts webhook messages to
BC_CHAT_ID=

# ────────────────────────────────────────────────────────────────
# Cron
# ────────────────────────────────────────────────────────────────

# Shared secret required in the x-cron-secret header for scheduled
# cron routes (e.g. auto-checkout, WFH reminder). Set the same value
# in Vercel's cron configuration.
CRON_SECRET=

# ────────────────────────────────────────────────────────────────
# Misc / app URLs
# ────────────────────────────────────────────────────────────────

# Public base URL of the deployed app (used to build absolute links,
# e.g. in push notifications and server-to-server calls)
NEXT_PUBLIC_APP_URL=

# Alternate/legacy public base URL reference used by some routes
NEXT_PUBLIC_BASE_URL=

# GIPHY API key (server-side) used by the "get well" giphy integration
GIPHY_API_KEY=

# GIPHY API key exposed to the client, if the giphy widget calls the
# GIPHY API directly from the browser
NEXT_PUBLIC_GIPHY_API_KEY=
